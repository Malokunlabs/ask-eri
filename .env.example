# Server-only. Configure these in .env.local and in the hosting environment.
# Share only the source spreadsheet with this account as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM value; escaped \n is supported. Never prefix these variables with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Requested-email service. Keep disabled until all live prerequisites are reviewed.
# Development defaults to a local outbox. Production never falls back to local files.
ERI_ENGAGEMENT_MODE=
ERI_SITE_URL=
RESEND_API_KEY=
ERI_EMAIL_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Separate cryptographically random values, at least 32 characters each.
ERI_OPERATIONS_SECRET=
CRON_SECRET=
# Optional: internal sign-off reference after consent, instruments and panel QA review.
# Leave blank to withhold matched series even if verified pairs exist.
ERI_PANEL_APPROVAL_REFERENCE=
